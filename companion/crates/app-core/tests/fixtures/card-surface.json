{
  "schema_version": 9,
  "preferences": {
    "timezone": "Asia/Tbilisi",
    "autostart": true,
    "paused": false,
    "orientation": "landscape-flipped"
  },
  "cards": [
    {
      "kind": "clock",
      "id": "analog",
      "title": "Home",
      "show_seconds": false,
      "template": { "kind": "analog-clock" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "none" }
    },
    {
      "kind": "pomodoro",
      "id": "focus",
      "label": "Focus",
      "duration_seconds": 1500,
      "template": { "kind": "progress-ring" },
      "tap_action": { "kind": "reset" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "on-timer-finish", "hold": { "kind": "until-dismissed" } }
    },
    {
      "kind": "picture",
      "id": "picture",
      "title": "Studio",
      "source_id": "studio",
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "manual" },
      "alert": { "kind": "none" }
    }
  ],
  "image_sources": [{ "id": "studio", "name": "Studio" }],
  "assets": [
    {
      "id": "icons",
      "source": { "kind": "file", "value": "/tmp/icons.ttf" },
      "kind": {
        "kind": "icon-font",
        "glyphs": [
          { "name": "cloud-rain", "codepoint": 63232 },
          { "name": "sun", "codepoint": 63233 }
        ]
      },
      "maximum_bytes": 262144
    },
    {
      "id": "font",
      "source": { "kind": "file", "value": "/tmp/font.ttf" },
      "kind": { "kind": "font" },
      "maximum_bytes": 262144
    }
  ],
  "playlists": [
    {
      "id": "p1",
      "name": "Screens",
      "advance": { "kind": "timed", "default_dwell_seconds": 30 },
      "entries": [
        { "card_id": "analog", "dwell_seconds": null },
        { "card_id": "focus", "dwell_seconds": null },
        { "card_id": "picture", "dwell_seconds": null }
      ]
    }
  ],
  "active_playlist_id": "p1",
  "updater": { "channel": "beta", "checks": "notify" }
}
