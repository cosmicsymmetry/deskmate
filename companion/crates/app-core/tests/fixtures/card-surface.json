{
  "schema_version": 5,
  "preferences": {
    "timezone": "Asia/Tbilisi",
    "autostart": true,
    "paused": false,
    "orientation": "landscape-flipped"
  },
  "cards": [
    {
      "kind": "clock",
      "id": "analog",
      "title": "Home",
      "show_seconds": false,
      "template": { "kind": "analog-clock" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "none" }
    },
    {
      "kind": "pomodoro",
      "id": "focus",
      "label": "Focus",
      "duration_seconds": 1500,
      "template": { "kind": "progress-ring" },
      "tap_action": { "kind": "reset" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "on-timer-finish", "hold": { "kind": "until-dismissed" } }
    },
    {
      "kind": "calendar",
      "id": "agenda",
      "title": "Up next",
      "source": { "kind": "url", "value": "https://example.test/calendar.ics" },
      "template": { "kind": "row-list" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "interval", "minutes": 15 },
      "alert": { "kind": "before-event", "lead_minutes": 5, "hold": { "kind": "seconds", "value": 60 } }
    },
    {
      "kind": "weather",
      "id": "weather",
      "title": "Weather",
      "location": "Tbilisi",
      "units": "metric",
      "template": { "kind": "icon-badge-text", "icon_asset_id": "icons" },
      "tap_action": { "kind": "open-url", "url": "https://example.test/weather" },
      "refresh": { "kind": "interval", "minutes": 30 },
      "alert": { "kind": "none" }
    },
    {
      "kind": "json-feed",
      "id": "metric",
      "title": "Metric",
      "url": "https://example.test/metric.json",
      "mappings": [
        { "field": "value", "path": "$.current.value" },
        { "field": "label", "path": "$.current.label" }
      ],
      "template": { "kind": "big-number-label" },
      "tap_action": { "kind": "open-application", "application_id": "com.example.metrics" },
      "refresh": { "kind": "manual" },
      "alert": { "kind": "none" }
    },
    {
      "kind": "rss",
      "id": "news",
      "title": "News",
      "url": "https://example.test/feed.xml",
      "max_items": 5,
      "template": { "kind": "row-list" },
      "tap_action": { "kind": "dismiss" },
      "refresh": { "kind": "interval", "minutes": 60 },
      "alert": { "kind": "none" }
    }
  ],
  "assets": [
    {
      "id": "icons",
      "source": { "kind": "file", "value": "/tmp/icons.ttf" },
      "kind": {
        "kind": "icon-font",
        "glyphs": [
          { "name": "cloud-rain", "codepoint": 63232 },
          { "name": "sun", "codepoint": 63233 }
        ]
      },
      "maximum_bytes": 262144
    },
    {
      "id": "font",
      "source": { "kind": "file", "value": "/tmp/font.ttf" },
      "kind": { "kind": "font" },
      "maximum_bytes": 262144
    }
  ],
  "playlists": [
    {
      "id": "p1",
      "name": "Screens",
      "advance": { "kind": "timed", "default_dwell_seconds": 30 },
      "entries": [
        { "card_id": "analog", "dwell_seconds": null },
        { "card_id": "focus", "dwell_seconds": null },
        { "card_id": "agenda", "dwell_seconds": null },
        { "card_id": "weather", "dwell_seconds": null },
        { "card_id": "metric", "dwell_seconds": null },
        { "card_id": "news", "dwell_seconds": null }
      ]
    }
  ],
  "active_playlist_id": "p1",
  "updater": { "channel": "beta", "checks": "notify" }
}
