{
  "schema_version": 4,
  "preferences": {
    "timezone": "UTC",
    "autostart": false,
    "paused": false,
    "orientation": "landscape"
  },
  "cards": [
    {
      "kind": "clock",
      "id": "clock",
      "title": "Desk",
      "show_seconds": true,
      "template": { "kind": "digital-clock" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "none" }
    }
  ],
  "assets": [],
  "playlists": [
    {
      "id": "my-playlist",
      "name": "My playlist",
      "advance": { "kind": "manual" },
      "entries": [
        { "card_id": "clock", "dwell_seconds": null }
      ]
    }
  ],
  "active_playlist_id": "my-playlist",
  "updater": { "channel": "stable", "checks": "notify" }
}
