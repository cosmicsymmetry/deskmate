{
  "schema_version": 6,
  "preferences": {
    "timezone": "Asia/Tbilisi",
    "autostart": true,
    "paused": false,
    "orientation": "landscape-flipped"
  },
  "cards": [
    {
      "kind": "clock",
      "id": "clock",
      "title": "Desk",
      "show_seconds": true,
      "template": { "kind": "digital-clock" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "none" }
    },
    {
      "kind": "pomodoro",
      "id": "pomodoro",
      "label": "Focus",
      "duration_seconds": 1500,
      "template": { "kind": "progress-ring" },
      "tap_action": { "kind": "start-pause" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "on-timer-finish", "hold": { "kind": "until-dismissed" } }
    },
    {
      "kind": "calendar",
      "id": "calendar",
      "title": "Calendar",
      "source": {
        "kind": "url",
        "value": "https://example.com/calendar.ics"
      },
      "template": { "kind": "row-list" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "interval", "minutes": 15 },
      "alert": { "kind": "none" }
    }
  ],
  "assets": [],
  "playlists": [
    {
      "id": "p1",
      "name": "Screens",
      "advance": { "kind": "manual" },
      "entries": [
        { "card_id": "clock", "dwell_seconds": null },
        { "card_id": "pomodoro", "dwell_seconds": null },
        { "card_id": "calendar", "dwell_seconds": null }
      ]
    }
  ],
  "active_playlist_id": "p1",
  "updater": { "channel": "stable", "checks": "notify" }
}
