{
  "schema_version": 10,
  "preferences": {
    "timezone": "Asia/Tbilisi",
    "autostart": true,
    "paused": false,
    "orientation": "landscape-flipped"
  },
  "cards": [
    {
      "kind": "clock",
      "id": "clock",
      "title": "Desk",
      "show_seconds": true,
      "template": { "kind": "digital-clock" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "none" },
      "dwell_seconds": null
    },
    {
      "kind": "pomodoro",
      "id": "pomodoro",
      "label": "Focus",
      "duration_seconds": 1500,
      "template": { "kind": "progress-ring" },
      "tap_action": { "kind": "start-pause" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "on-timer-finish", "hold": { "kind": "until-dismissed" } },
      "dwell_seconds": null
    },
    {
      "kind": "picture",
      "id": "picture",
      "title": "Status picture",
      "source_id": "status",
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "manual" },
      "alert": { "kind": "none" },
      "dwell_seconds": null
    }
  ],
  "image_sources": [
    { "id": "status", "name": "Status" }
  ],
  "assets": [],
  "advance": { "kind": "manual" },
  "updater": { "channel": "stable", "checks": "notify" }
}
