{
  "schema_version": 7,
  "preferences": {
    "timezone": "Not/A_Timezone",
    "autostart": false,
    "paused": false,
    "orientation": "landscape"
  },
  "cards": [
    {
      "kind": "clock",
      "id": "on-timer-mismatch",
      "title": "Desk",
      "show_seconds": true,
      "template": { "kind": "digital-clock" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "on-timer-finish", "hold": { "kind": "until-dismissed" } }
    },
    {
      "kind": "clock",
      "id": "duplicate",
      "title": "Desk",
      "show_seconds": true,
      "template": { "kind": "digital-clock" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "none" }
    },
    {
      "kind": "pomodoro",
      "id": "duplicate",
      "label": "Focus",
      "duration_seconds": 1500,
      "template": { "kind": "progress-ring" },
      "tap_action": { "kind": "start-pause" },
      "refresh": { "kind": "device-local" },
      "alert": { "kind": "none" }
    },
    {
      "kind": "calendar",
      "id": "calendar-a",
      "title": "Calendar",
      "source": {
        "kind": "url",
        "value": "calendar.example/feed"
      },
      "template": { "kind": "row-list" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "interval", "minutes": 15 },
      "alert": {
        "kind": "before-event",
        "lead_minutes": 61,
        "hold": { "kind": "seconds", "value": 60 }
      }
    },
    {
      "kind": "pomodoro",
      "id": "pomodoro-b",
      "label": "Focus",
      "duration_seconds": 1500,
      "template": { "kind": "progress-ring" },
      "tap_action": { "kind": "start-pause" },
      "refresh": { "kind": "device-local" },
      "alert": {
        "kind": "on-timer-finish",
        "hold": { "kind": "seconds", "value": 4 }
      }
    },
    {
      "kind": "weather",
      "id": "orphan",
      "title": "Orphan",
      "location": "Nowhere",
      "units": "metric",
      "template": { "kind": "icon-badge-text", "icon_asset_id": "missing-icon" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "interval", "minutes": 30 },
      "alert": { "kind": "none" }
    }
  ],
  "assets": [],
  "playlists": [
    {
      "id": "p1",
      "name": "Main",
      "advance": { "kind": "manual" },
      "entries": [
        { "card_id": "on-timer-mismatch", "dwell_seconds": null },
        { "card_id": "duplicate", "dwell_seconds": 4 },
        { "card_id": "calendar-a", "dwell_seconds": null },
        { "card_id": "pomodoro-b", "dwell_seconds": null },
        { "card_id": "ghost", "dwell_seconds": null },
        { "card_id": "on-timer-mismatch", "dwell_seconds": null }
      ]
    },
    {
      "id": "p2",
      "name": "Main",
      "advance": { "kind": "manual" },
      "entries": [
        { "card_id": "orphan", "dwell_seconds": null }
      ]
    }
  ],
  "active_playlist_id": "p1",
  "updater": { "channel": "stable", "checks": "notify" }
}
