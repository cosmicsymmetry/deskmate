{
  "schema_version": 3,
  "preferences": {
    "timezone": "Not/A_Timezone",
    "autostart": false,
    "paused": false,
    "orientation": "landscape"
  },
  "cards": [
    {
      "kind": "clock",
      "id": "duplicate",
      "title": "Desk",
      "show_seconds": true,
      "template": { "kind": "digital-clock" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "device-local" },
      "presence": { "kind": "in-rotation", "dwell_seconds": null },
      "alert": { "kind": "none" }
    },
    {
      "kind": "pomodoro",
      "id": "duplicate",
      "label": "Focus",
      "duration_seconds": 0,
      "template": { "kind": "progress-ring" },
      "tap_action": { "kind": "start-pause" },
      "refresh": { "kind": "device-local" },
      "presence": { "kind": "in-rotation", "dwell_seconds": null },
      "alert": { "kind": "none" }
    },
    {
      "kind": "calendar",
      "id": "calendar",
      "title": "Calendar",
      "source": {
        "kind": "url",
        "value": "calendar.example/feed"
      },
      "template": { "kind": "row-list" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "interval", "minutes": 0 },
      "presence": { "kind": "in-rotation", "dwell_seconds": null },
      "alert": { "kind": "none" }
    },
    {
      "kind": "weather",
      "id": "orphan",
      "title": "Orphan",
      "location": "Nowhere",
      "units": "metric",
      "template": { "kind": "icon-badge-text", "icon_asset_id": "missing-icon" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "interval", "minutes": 30 },
      "presence": { "kind": "alert-only" },
      "alert": { "kind": "none" }
    }
  ],
  "assets": [],
  "carousel": { "advance": { "kind": "timed", "default_dwell_seconds": 1 } },
  "updater": { "channel": "stable", "checks": "notify" }
}
