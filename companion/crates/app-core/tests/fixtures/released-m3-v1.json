{
  "schema_version": 1,
  "preferences": {
    "timezone": "Asia/Tbilisi",
    "autostart": true,
    "paused": false,
    "orientation": "landscape-flipped"
  },
  "widgets": [
    {
      "kind": "clock",
      "id": "clock",
      "size": "full",
      "title": "Desk",
      "show_seconds": true
    },
    {
      "kind": "pomodoro",
      "id": "pomodoro",
      "size": "standard",
      "label": "Focus",
      "duration_seconds": 1500
    },
    {
      "kind": "calendar",
      "id": "calendar",
      "size": "standard",
      "title": "Calendar",
      "source": {
        "kind": "url",
        "value": "https://example.com/calendar.ics"
      },
      "refresh_minutes": 15
    }
  ],
  "screens": [
    { "id": "pomodoro-screen", "widget_id": "pomodoro" },
    { "id": "clock-screen", "widget_id": "clock" },
    { "id": "calendar-screen", "widget_id": "calendar" }
  ]
}
