{
  "schema_version": 3,
  "preferences": {
    "timezone": "Asia/Tbilisi",
    "autostart": true,
    "paused": false,
    "orientation": "landscape-flipped"
  },
  "cards": [
    {
      "kind": "clock",
      "id": "a",
      "title": "Desk",
      "show_seconds": true,
      "template": { "kind": "analog-clock" },
      "tap_action": { "kind": "none" },
      "refresh": { "kind": "device-local" },
      "presence": { "kind": "in-rotation", "dwell_seconds": 20 },
      "alert": { "kind": "none" }
    },
    {
      "kind": "pomodoro",
      "id": "b",
      "label": "Deep work",
      "duration_seconds": 1200,
      "template": { "kind": "progress-ring" },
      "tap_action": { "kind": "reset" },
      "refresh": { "kind": "device-local" },
      "presence": { "kind": "alert-only" },
      "alert": { "kind": "on-timer-finish", "hold": { "kind": "until-dismissed" } }
    },
    {
      "kind": "calendar",
      "id": "c",
      "title": "Meetings",
      "source": { "kind": "url", "value": "https://example.test/calendar.ics" },
      "template": { "kind": "row-list" },
      "tap_action": { "kind": "dismiss" },
      "refresh": { "kind": "interval", "minutes": 20 },
      "presence": { "kind": "off" },
      "alert": { "kind": "before-event", "lead_minutes": 10, "hold": { "kind": "seconds", "value": 90 } }
    },
    {
      "kind": "weather",
      "id": "d",
      "title": "Outside",
      "location": "Tbilisi",
      "units": "metric",
      "template": { "kind": "big-number-label" },
      "tap_action": { "kind": "open-url", "url": "https://example.test/weather" },
      "refresh": { "kind": "interval", "minutes": 30 },
      "presence": { "kind": "in-rotation", "dwell_seconds": null },
      "alert": { "kind": "none" }
    }
  ],
  "assets": [],
  "carousel": { "advance": { "kind": "timed", "default_dwell_seconds": 30 } },
  "updater": { "channel": "beta", "checks": "notify" }
}
