# Environment file for the Deskmate server, consumed by both the launchd
# plist and the systemd unit in this directory. Copy this file to a path
# outside version control (the launchd plist and systemd unit both expect
# /etc/deskmate/server.env by default -- see README.md to change that),
# fill in a real admin token, and lock down its permissions:
#
#   sudo install -d -m 0755 /etc/deskmate
#   sudo install -m 0600 deskmate-server.env.example /etc/deskmate/server.env
#   sudo $EDITOR /etc/deskmate/server.env
#
# DESKMATE_ADMIN_TOKEN is a bearer secret for the Mac-facing surface. Never
# commit a real value, and never put it in shell history -- generate it with
# something like `openssl rand -hex 32` and paste it directly into the file.
#
# DESKMATE_CONFIG_DIR holds per-device configs and device-identities.json. The
# identity file contains device ids and SHA-256 token digests, never bearer
# tokens, and is created 0600 with atomic replacement. Preserve this directory
# across restarts; losing the identity file requires minting and USB-provisioning
# replacement identities because the original tokens cannot be recovered.

# RUST_LOG is load-bearing, not a nicety. main.rs uses
# tracing_subscriber::fmt::init(), whose EnvFilter defaults to ERROR when this
# is unset, so every device-link diagnostic -- "device link established",
# "device link refused: owner already live", the unknown-token warnings -- is
# discarded. The one line still visible at startup comes from a println!, which
# makes logging look alive while it reports nothing. The launchd plist in this
# directory sets RUST_LOG itself; the systemd unit takes it from this file
# only, so leaving it out here silences that deployment specifically. A live
# server was found running this way on 2026-08-19, which made one of V2's
# acceptance criteria impossible to satisfy.
RUST_LOG=info

DESKMATE_SERVER_BIND=127.0.0.1:8443
DESKMATE_FIRMWARE_DIR=/var/lib/deskmate/firmware
DESKMATE_CONFIG_DIR=/var/lib/deskmate/configs
# Required: copy the exact firmware/version.txt value for the published image.
DESKMATE_FIRMWARE_VERSION=v2.0.0-live2
DESKMATE_ADMIN_TOKEN=replace-with-a-real-random-token

# DESKMATE_DATA_CARDS points at the server-rendered card specs
# (docs/images/server-rendered-cards.md). Leave it unset and the server looks
# for data-cards.json inside DESKMATE_CONFIG_DIR; a missing file simply means
# this deployment has no server-rendered cards, which is not an error.
#
# A MALFORMED file fails the start on purpose. The alternative -- coming up with
# cards silently missing -- presents as "the panel stopped updating" with
# nothing in the log to explain it.
#
# Setting this also means the server makes outbound HTTP again, to Open-Meteo,
# CoinGecko and whatever feed URLs the specs name. Every request goes through
# the SSRF guard in crates/server/src/egress.rs.
#DESKMATE_DATA_CARDS=/var/lib/deskmate/configs/data-cards.json
