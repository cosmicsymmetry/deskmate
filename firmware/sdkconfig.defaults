CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# mbedTLS defaults to MBEDTLS_INTERNAL_MEM_ALLOC, which confines every TLS
# allocation to internal DRAM. On this board internal DRAM is already spoken
# for by LVGL's draw buffers and WiFi's static .bss, so mbedtls_ssl_setup()
# cannot obtain its SSL_IN_CONTENT_LEN buffer and returns -0x7F00
# (MBEDTLS_ERR_SSL_ALLOC_FAILED) before any socket work happens. Every TLS
# connection then fails identically -- the WSS link never opens and the OTA
# check never reaches the server -- while status still reports megabytes of
# free heap, because that heap is PSRAM, the one pool mbedTLS was forbidden.
# Observed on hardware 2026-08-19; see docs/hardware/board-notes.md.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# LVGL reads the single checked-in firmware/lv_conf.h instead of synthesizing
# its config from Kconfig. firmware/main/CMakeLists.txt adds firmware/ to the
# global build include path so every translation unit that includes lvgl.h
# (LVGL itself, esp_lvgl_port, and our own board/ui code) can find it.
CONFIG_LV_CONF_SKIP=n
